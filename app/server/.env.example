# ---------------------------------------------------------------------------------
# CryptoVault server settings. Copy this file to ".env" (same folder) and fill in.
# ---------------------------------------------------------------------------------

# MongoDB connection string (REQUIRED). Paste the URL you were given, e.g.
#   MongoDB Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cryptovault?retryWrites=true&w=majority
#   Local MongoDB : mongodb://127.0.0.1:27017/cryptovault
# If the password contains special characters, URL-encode them (@ -> %40, # -> %23, / -> %2F).
MONGO_URI=

# Optional: database name (overrides the name in the URI; default "cryptovault")
MONGO_DB=

PORT=5000
JWT_SECRET=change-me-group18

# create demo users alice / bob / charlie / mallory when the database has no users
SEED_DEMO=true
